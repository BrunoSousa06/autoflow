---
config:
  theme: mc
---
sequenceDiagram
    autonumber
    actor Atendente
    actor Mecanico
    participant Frontend as Frontend Angular
    participant Auth as JWT/Spring Security
    participant OSController as OrdemServicoController
    participant OSService as OrdemServicoService
    participant ClienteService as ClienteService
    participant VeiculoService as VeiculoService
    participant OrcamentoFactory as OrcamentoFactory
    participant Publicacao as OrcamentoPublicacaoService
    participant Notificacao as OrcamentoNotificacaoService
    participant Email as EmailNotificacaoService
    participant DB as PostgreSQL

    Atendente->>Frontend: Informa cliente, veiculo e servicos
    Frontend->>Auth: Envia JWT
    Auth-->>Frontend: Usuario autorizado
    Frontend->>OSController: POST /ordens-servico
    OSController->>OSService: criar(cpfCnpj, veiculo, servicos)
    OSService->>ClienteService: buscarPorCpfCnpj(cpfCnpj)
    ClienteService->>DB: Consulta cliente
    DB-->>ClienteService: Cliente encontrado
    OSService->>VeiculoService: buscarOuCadastrarPorPlacaParaCliente()
    VeiculoService->>DB: Consulta/cadastra veiculo
    DB-->>VeiculoService: Veiculo associado
    OSService->>DB: Salva OS e historico
    DB-->>OSService: OS criada
    OSService-->>OSController: OrdemServicoEntity
    OSController-->>Frontend: 201 OrdemServicoResponse

    Atendente->>Frontend: Atribui mecanico
    Frontend->>OSController: PATCH /ordens-servico/{numeroOs}/mecanico
    OSController->>OSService: atribuirMecanico(numeroOs, mecanicoId/email)
    OSService->>DB: Atualiza diagnostico.mecanico
    DB-->>OSService: OS atualizada
    OSService-->>OSController: OrdemServicoEntity
    OSController-->>Frontend: 202 OrdemServicoResponse

    Mecanico->>Frontend: Inicia diagnostico
    Frontend->>OSController: PATCH /ordens-servico/{numeroOs}/diagnostico/iniciar
    OSController->>OSService: iniciarDiagnostico(numeroOs, emailUsuario)
    OSService->>DB: Atualiza status para EM_DIAGNOSTICO e registra historico
    DB-->>OSService: OS atualizada
    OSService-->>OSController: OrdemServicoEntity
    OSController-->>Frontend: 202 OrdemServicoResponse

    Mecanico->>Frontend: Registra laudo e itens necessarios
    Frontend->>OSController: PATCH /diagnostico/laudo
    OSController->>OSService: registrarLaudo(numeroOs, emailUsuario, laudo)
    OSService->>DB: Salva laudo
    Frontend->>OSController: PATCH /servicos/{servicoId}/itens-necessarios
    OSController->>OSService: registrarItemNecessario(...)
    OSService->>DB: Salva pecas/insumos do servico

    Mecanico->>Frontend: Finaliza diagnostico
    Frontend->>OSController: PATCH /ordens-servico/{numeroOs}/diagnostico/finalizar
    OSController->>OSService: finalizarDiagnostico(numeroOs, emailUsuario)
    OSService->>DB: Busca OS
    OSService->>OrcamentoFactory: criarPrincipalDisponivel(OS, versao, data)
    OrcamentoFactory-->>OSService: OrcamentoEntity DISPONIVEL
    OSService->>DB: Salva orcamento
    OSService->>Publicacao: publicar(orcamentoId)
    Publicacao ->> DB: Salva hash e expiracao do token publico
    Publicacao -->> OSService: URL do PDF e pagina de decisao
    OSService ->> Notificacao: enviar links do PDF e da decisao ao cliente
    Notificacao->>Email: enviar(mensagem)
    Email-->>Notificacao: E-mail enviado ou erro tratado em log
    OSService->>DB: Atualiza OS para AGUARDANDO_APROVACAO e registra historico
    OSService-->>OSController: FinalizarDiagnosticoResult
    OSController-->>Frontend: 202 OS + orcamentoId + publicUrl
