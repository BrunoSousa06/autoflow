sequenceDiagram
    autonumber

    actor Mecanico

    box Aplicação Cliente
        participant Frontend as Frontend Angular
    end

    box API Spring Boot
        participant Security as JWT / Spring Security
        participant ReparoController as ReparoAdicionalController
        participant ReparoUseCase as CriarReparoAdicionalUseCase
        participant Publicacao as OrcamentoPublicacaoGateway
        participant Notificacao as OrcamentoNotificacaoGateway
    end

    participant DB as PostgreSQL

    Note over Mecanico,DB: Registro de reparo adicional durante a execucao da OS

    Mecanico->>Frontend: Informa novos servicos, pecas ou insumos
    Frontend->>Security: POST /ordens-servico/{numeroOs}/reparos-adicionais + Bearer JWT

    activate Security
    Security->>Security: Valida autenticacao e permissao do mecanico
    Security->>ReparoController: Encaminha requisição autorizada
    deactivate Security

    activate ReparoController
    ReparoController->>ReparoUseCase: execute(command)

    activate ReparoUseCase
    ReparoUseCase->>DB: Busca OS em EM_EXECUCAO
    DB-->>ReparoUseCase: OS encontrada

    ReparoUseCase->>ReparoUseCase: Valida se OS permite reparo adicional

    ReparoUseCase->>DB: Cria reparo adicional com aprovacao pendente
    DB-->>ReparoUseCase: Reparo adicional criado

    ReparoUseCase->>DB: Cria orcamento complementar pendente
    DB-->>ReparoUseCase: Orcamento complementar salvo

    ReparoUseCase->>Publicacao: publicar(orcamentoId)
    activate Publicacao

    Publicacao->>DB: Salva hash do token publico
    DB-->>Publicacao: Token publico registrado

    Publicacao-->>ReparoUseCase: URL publica do PDF
    deactivate Publicacao

    ReparoUseCase->>Notificacao: enviarLinkOrcamentoParaCliente(orcamento, OS, publicUrl)
    activate Notificacao

    alt Notificacao enviada
        Notificacao-->>ReparoUseCase: Envio confirmado
    else Erro no envio
        Notificacao-->>ReparoUseCase: Erro tratado em log
    end

    deactivate Notificacao

    ReparoUseCase-->>ReparoController: Output com reparo, orcamento e URL
    deactivate ReparoUseCase

    ReparoController-->>Frontend: 201 Created + orcamentoId + publicUrl
    deactivate ReparoController
