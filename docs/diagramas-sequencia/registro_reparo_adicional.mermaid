sequenceDiagram
    autonumber

    actor Mecanico

    box Aplicação Cliente
        participant Frontend as Frontend Angular
    end

    box API Spring Boot
        participant Security as JWT / Spring Security
        participant ReparoController as ReparoAdicionalController
        participant ReparoService as ReparoAdicionalService
        participant Publicacao as OrcamentoPublicacaoService
        participant Notificacao as OrcamentoNotificacaoService
    end

    participant DB as PostgreSQL

    Note over Mecanico,DB: Registro de reparo adicional durante a execucao da OS

    Mecanico->>Frontend: Informa novos servicos, pecas ou insumos
    Frontend->>Security: POST /ordens-servico/{numeroOs}/reparos-adicionais + Bearer JWT

    activate Security
    Security->>Security: Valida autenticacao e permissao do mecanico
    Security->>ReparoController: Encaminha requisição autorizada
    deactivate Security

    activate ReparoController
    ReparoController->>ReparoService: criar(numeroOs, emailMecanico, servicosAdicionais)

    activate ReparoService
    ReparoService->>DB: Busca OS em EM_EXECUCAO
    DB-->>ReparoService: OS encontrada

    ReparoService->>ReparoService: Valida se OS permite reparo adicional

    ReparoService->>DB: Cria reparo adicional com aprovacao pendente
    DB-->>ReparoService: Reparo adicional criado

    ReparoService->>DB: Cria orcamento complementar pendente
    DB-->>ReparoService: Orcamento complementar salvo

    ReparoService->>Publicacao: publicar(orcamentoId)
    activate Publicacao

    Publicacao->>DB: Salva hash do token publico
    DB-->>Publicacao: Token publico registrado

    Publicacao-->>ReparoService: URL publica do PDF
    deactivate Publicacao

    ReparoService->>Notificacao: enviarLinkOrcamentoParaCliente(orcamento, OS, publicUrl)
    activate Notificacao

    alt Notificacao enviada
        Notificacao-->>ReparoService: Envio confirmado
    else Erro no envio
        Notificacao-->>ReparoService: Erro tratado em log
    end

    deactivate Notificacao

    ReparoService-->>ReparoController: Reparo adicional e orcamento complementar
    deactivate ReparoService

    ReparoController-->>Frontend: 201 Created + orcamentoId + publicUrl
    deactivate ReparoController
