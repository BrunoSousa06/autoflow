sequenceDiagram
    autonumber
    actor Cliente
    participant Email as E-mail
    participant Frontend as Frontend publico

    box API Spring Boot
        participant PublicController as PublicOrcamentoController
        participant Decision as DecidirOrcamentoUseCase
        participant Publication as OrcamentoPublicacaoGateway
    end

    participant DB as PostgreSQL
    Note over Cliente, DB: Acesso sem autenticacao por token publico
    Cliente ->> Email: Abre o link recebido
    Email -->> Frontend: /public/orcamentos/{id}?token=...
    Frontend ->> PublicController: GET /public/orcamentos/{id}?token=...
    PublicController ->> Publication: validar token e expiracao
    Publication ->> DB: Busca hash e expiracao do orcamento
    DB -->> Publication: Token valido ou invalido

    alt Token invalido ou expirado
        Publication -->> PublicController: Falha de autenticacao
        PublicController -->> Frontend: 401 Unauthorized
    else Token valido
        PublicController -->> Frontend: 200 OrcamentoResponse sem dados sensiveis
        Cliente ->> Frontend: Consulta valores ou baixa o PDF

        alt Cliente aprova
            Frontend ->> PublicController: POST /public/orcamentos/{id}/aprovar
            PublicController ->> Decision: aprovarComoToken(id, token, nome)
            Decision ->> DB: Bloqueia orcamento para decisao
            Decision ->> Publication: Valida token novamente
            Decision ->> DB: Grava APROVADO, data e assinatura

            alt Orcamento principal
                Decision ->> DB: Atualiza OS para EM_EXECUCAO
            else Orcamento complementar
                Decision ->> DB: Aprova reparo adicional vinculado
            end

            Decision -->> PublicController: Orcamento aprovado
            PublicController -->> Frontend: 200 OrcamentoResponse

        else Cliente recusa
            Frontend ->> PublicController: POST /public/orcamentos/{id}/recusar
            PublicController ->> Decision: recusarComoToken(id, token, motivo, nome)
            Decision ->> DB: Bloqueia orcamento para decisao
            Decision ->> Publication: Valida token novamente
            Decision ->> DB: Grava REPROVADO, data, assinatura e motivo

            alt Orcamento principal
                Decision ->> DB: Finaliza OS conforme regra vigente
            else Orcamento complementar
                Decision ->> DB: Recusa reparo adicional vinculado
            end

            Decision -->> PublicController: Orcamento recusado
            PublicController -->> Frontend: 200 OrcamentoResponse
        end
    end
